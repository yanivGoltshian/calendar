# חיבור למסד הנתונים (PostgreSQL)
# עדכנו שם משתמש, סיסמה, מארח, פורט ושם מסד לפי הסביבה שלכם.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/torchick_dev?schema=public"

# אזור זמן עסקי ברירת מחדל (IANA)
BUSINESS_TIMEZONE="Asia/Jerusalem"

# מפתח לחתימת עוגיית ההתחברות של הלקוח (מחרוזת אקראית ארוכה)
SESSION_SECRET="change-me-to-a-long-random-string"

# "פלפל" להצפנת קודי OTP (מחרוזת אקראית ארוכה)
OTP_PEPPER="change-me-too"

# ספק ה-SMS: console = הדפסה ללוג בלבד (ברירת מחדל לפיתוח).
# ערכים אפשריים: console | twilio | httpgateway (alias: gateway).
# בפרודקשן חובה להגדיר twilio או httpgateway, אחרת שליחת ה-OTP תיכשל ברעש.
SMS_PROVIDER="console"

# ---------------------------------------------------------------------------
# מתאם Twilio (כאשר SMS_PROVIDER=twilio) - שולח SMS וגם WhatsApp דרך REST.
# ---------------------------------------------------------------------------
# חובה: מזהה החשבון וטוקן האימות (סודות).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# מקור השליחה ל-SMS: או Messaging Service SID או מספר TWILIO_FROM (אחד מהם חובה).
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM=""
# מספר שולח ל-WhatsApp (הפורמט whatsapp:+... מתווסף אוטומטית אם חסר).
# אם לא הוגדר, נופלים חזרה ל-TWILIO_FROM עבור WhatsApp.
TWILIO_WHATSAPP_FROM=""

# ---------------------------------------------------------------------------
# שער SMS ישראלי גנרי מבוסס HTTP (כאשר SMS_PROVIDER=httpgateway).
# ניתן להגדיר preset מוכן, או להגדיר ידנית endpoint/method/auth/payload.
# ---------------------------------------------------------------------------
# preset אופציונלי: 019 | inforu (קובע endpoint/מבנה payload ברירת מחדל).
SMS_GATEWAY_PRESET=""
# כתובת ה-endpoint של השער (דורש אם אין preset).
SMS_GATEWAY_ENDPOINT=""
# שיטת HTTP (ברירת מחדל POST).
SMS_GATEWAY_METHOD="POST"
# מצב אימות: bearer | basic | header | none.
SMS_GATEWAY_AUTH_MODE=""
# קרדנשלס אימות (סודות) - לפי מצב האימות שנבחר.
SMS_GATEWAY_TOKEN=""
SMS_GATEWAY_USERNAME=""
SMS_GATEWAY_PASSWORD=""
# שם כותרת אימות מותאם (כאשר SMS_GATEWAY_AUTH_MODE=header).
SMS_GATEWAY_AUTH_HEADER=""
# מזהה/שם השולח שמופיע ללקוח.
SMS_GATEWAY_FROM=""
# שמות שדות ה-payload (ברירות מחדל: to/text/from), לגמישות מול שערים שונים.
SMS_GATEWAY_TO_FIELD=""
SMS_GATEWAY_TEXT_FIELD=""
SMS_GATEWAY_FROM_FIELD=""
# JSON נוסף שממוזג לתוך ה-payload (מחרוזת JSON), לשדות ייחודיים לשער.
SMS_GATEWAY_EXTRA_JSON=""

# ---------------------------------------------------------------------------
# הגבלת קצב של בקשות OTP (הגנה מפני ניצול לרעה ועלויות). ערכים אופציונליים.
# ---------------------------------------------------------------------------
# קול-דאון בין שליחות חוזרות לאותו טלפון (שניות; ברירת מחדל 60).
OTP_COOLDOWN_SECONDS="60"
# תקרת בקשות ליום לכל טלפון (ברירת מחדל 8).
OTP_MAX_PER_PHONE_PER_DAY="8"
# תקרת בקשות ליום לכל כתובת IP (ברירת מחדל 30).
OTP_MAX_PER_IP_PER_DAY="30"

# כתובת בסיס ציבורית של האפליקציה (מזינה את ה-canonical וה-Open Graph).
# בפרודקשן יש להגדיר לכתובת הדומיין, למשל https://torchick.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
