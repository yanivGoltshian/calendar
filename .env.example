# חיבור למסד הנתונים (PostgreSQL)
# עדכנו שם משתמש, סיסמה, מארח, פורט ושם מסד לפי הסביבה שלכם.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/torchick_dev?schema=public"

# אזור זמן עסקי ברירת מחדל (IANA)
BUSINESS_TIMEZONE="Asia/Jerusalem"

# מפתח לחתימת עוגיית ההתחברות של הלקוח (מחרוזת אקראית ארוכה)
SESSION_SECRET="change-me-to-a-long-random-string"

# "פלפל" להצפנת קודי OTP (מחרוזת אקראית ארוכה)
OTP_PEPPER="change-me-too"

# ספק ההודעות: console = הדפסה ללוג בלבד (ברירת מחדל לפיתוח).
# ערכים אפשריים: console | whatsapp-cloud (alias: whatsapp).
# בפרודקשן חובה להגדיר whatsapp-cloud, אחרת שליחת ה-OTP תיכשל ברעש.
# תאימות לאחור: אם MESSAGING_PROVIDER לא מוגדר, נקרא SMS_PROVIDER.
MESSAGING_PROVIDER="console"

# ---------------------------------------------------------------------------
# תזכורת התור (24 שעות לפני) נשלחת אך ורק דרך שכבת ההודעות בערוץ WhatsApp,
# בקריאה ל-getMessagingProvider().sendWhatsApp. שם תבנית ה-utility לתזכורת
# מוגדר ב-WHATSAPP_REMINDER_TEMPLATE בתוך בלוק ה-WhatsApp Cloud למטה.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# מתאם WhatsApp Cloud API של מטא (כאשר MESSAGING_PROVIDER=whatsapp-cloud).
# שולח OTP דרך תבנית authentication מאושרת, תזכורות דרך תבנית utility,
# והודעות טקסט חופשי.
# ---------------------------------------------------------------------------
# חובה: מזהה מספר הטלפון העסקי (Graph phone number id).
WHATSAPP_PHONE_NUMBER_ID=""
# חובה: access token של WhatsApp Cloud API (סוד; בפרודקשן דרך secretRef).
WHATSAPP_ACCESS_TOKEN=""
# חובה: שם תבנית ה-OTP המאושרת (authentication) ב-Meta.
WHATSAPP_OTP_TEMPLATE=""
# תזכורת: שם תבנית ה-utility (business-initiated) המאושרת ב-Meta לתזכורת התור.
# השכבה משתמשת בשם זה כשהיא שולחת את התזכורת (24 שעות לפני) בערוץ WhatsApp.
WHATSAPP_REMINDER_TEMPLATE=""
# אופציונלי: מזהה חשבון ה-WhatsApp Business (לתיעוד/עתיד).
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# אופציונלי: קוד שפת התבנית (ברירת מחדל he; חייב להתאים לתבנית שאושרה, למשל en_US).
WHATSAPP_OTP_TEMPLATE_LANG="he"
# אופציונלי: סוג כפתור העתקת-קוד בתבנית (ברירת מחדל url; none/ריק = ללא כפתור).
WHATSAPP_OTP_BUTTON_SUBTYPE="url"
# אופציונלי: גרסת Graph API (ברירת מחדל v21.0).
WHATSAPP_GRAPH_VERSION="v21.0"
# אופציונלי: כתובת בסיס של Graph (ברירת מחדל https://graph.facebook.com).
WHATSAPP_GRAPH_BASE_URL="https://graph.facebook.com"
# אופציונלי: קידומת מדינה ברירת מחדל לנרמול מספרים מקומיים (ברירת מחדל 972).
WHATSAPP_DEFAULT_COUNTRY_CODE="972"

# ---------------------------------------------------------------------------
# הגבלת קצב של בקשות OTP (הגנה מפני ניצול לרעה ועלויות). ערכים אופציונליים.
# ---------------------------------------------------------------------------
# קול-דאון בין שליחות חוזרות לאותו טלפון (שניות; ברירת מחדל 60).
OTP_COOLDOWN_SECONDS="60"
# תקרת בקשות ליום לכל טלפון (ברירת מחדל 8).
OTP_MAX_PER_PHONE_PER_DAY="8"
# תקרת בקשות ליום לכל כתובת IP (ברירת מחדל 30).
OTP_MAX_PER_IP_PER_DAY="30"

# כתובת בסיס ציבורית של האפליקציה (מזינה את ה-canonical וה-Open Graph).
# בפרודקשן יש להגדיר לכתובת הדומיין, למשל https://torchick.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# סוד לאימות ה-cron של התזכורות (/api/cron/reminders) ושל הקמפיינים המתוזמנים
# (/api/cron/campaigns) — אותו סוד משמש את שני ה-endpoints.
# מחרוזת אקראית ארוכה. חייב להיות מוגדר באותו ערך בשני מקומות בפרודקשן:
#   1) Repository secret בשם CRON_SECRET (ה-workflows המתוזמנים שולחים אותו ככותרת).
#   2) משתנה סביבה CRON_SECRET על ה-Container App (torchick-app-prod).
# אם השניים לא תואמים, ה-endpoints יחזירו 401 וההודעות לא יישלחו.
# הערה: שליחת הקמפיינים בפועל (email / SMS / WhatsApp) מסתמכת על ספק ההודעות
# (MESSAGING_PROVIDER) ובלוק ה-WhatsApp Cloud למעלה, ועל EMAIL_SERVER/EMAIL_FROM
# לערוץ המייל. ללא הגדרות חיות — הקמפיינים נכתבים ליומן בלבד (מצב console).
CRON_SECRET="change-me-to-a-long-random-string"

# ── כניסת בעלי עסק (NextAuth / Auth.js) ─────────────────────────────
# session מבוסס JWT בלבד (בלי טבלאות auth נוספות).

# סוד לחתימת ה-JWT של NextAuth (מחרוזת אקראית ארוכה). חובה בפרודקשן.
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# כתובת בסיס ציבורית ל-callbacks של NextAuth, למשל https://torchick.com
NEXTAUTH_URL="http://localhost:3000"

# ── origin קנוני יחיד (canonical host) ──────────────────────────────
# האפליקציה עשויה להיות נגישה תחת כמה origins שמצביעים לאותו Container App
# (דומיין ממותג + ה-FQDN המובנה של Azure). אם ההתחברות מתחילה על origin אחד
# וה-callback של Google נוחת על origin אחר, עוגיית ה-PKCE חסרה ו-Auth.js נכשל
# (InvalidCheck → עמוד Configuration). ה-middleware מרכז כל בקשת GET/HEAD
# ל-origin קנוני יחיד לפני תחילת ההתחברות.
#
# מקור ה-origin הקנוני נגזר לפי סדר עדיפות:
#   APP_CANONICAL_URL → AUTH_URL → NEXTAUTH_URL → NEXT_PUBLIC_APP_URL
# משתנה זה (APP_CANONICAL_URL) הוא override מפורש ואופציונלי; אם ריק, נגזר
# אוטומטית מהמשתנים הבאים. no-op בטוח כשאין ערך, כשה-host כבר תואם, או ל-probes.
# בפרודקשן יש להגדיר לדומיין הממותג, למשל https://torchick.duckdns.org
APP_CANONICAL_URL=""

# ספק Google (מגודר): הכפתור נטען רק כששני הערכים קיימים. ריק = מוסתר.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── כניסה במייל (OTP) לבעלים וללקוחות ───────────────────────────────
# המייל תמיד פעיל: אם EMAIL_SERVER ריק, הקוד נכתב ללוג בלבד בפורמט
# [email:console] to=<addr> code=<123456> (כמו ספק ה-console של ה-SMS),
# כך שאפשר לבדוק E2E בלי חשבון SMTP. כשמגדירים SMTP, נשלח מייל אמיתי.
# EMAIL_SERVER = כתובת SMTP מלאה, למשל smtp://user:pass@smtp.host.com:587
EMAIL_SERVER=""
# EMAIL_FROM = כתובת השולח, למשל "תור צ׳יק <no-reply@torchick.com>"
EMAIL_FROM=""

# ── אימות טלפון דרך Google Firebase (אופציונלי, מגודר) ───────────────
# מסלול נוסף לאימות טלפון (מעבר ל-OTP הטלפון הקיים). ה-UI מוסתר לגמרי
# כאשר NEXT_PUBLIC_FIREBASE_API_KEY ריק, כך שהפיצ׳ר "כבוי" עד שמזינים סודות.
# פרויקט: calendar-505218. אין להטמיע מפתחות בקוד — קריאה מ-env בלבד.
#
# צד לקוח (build-time, חשוף לדפדפן; NEXT_PUBLIC_):
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
#
# צד שרת (runtime, סודי; מ-Service Account של Firebase Admin):
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# המפתח הפרטי: יש לשמור עם \n מילוליים; הקוד ממיר אותם לשורות אמיתיות.
FIREBASE_PRIVATE_KEY=""

# ── ניהול-על (סופר-אדמין) ופנייה עסקית ──────────────────────────────
# רשימת מיילים (מופרדים בפסיק) שרשאים לגשת לקונסולת ניהול-העל ב-/superadmin.
# כל מייל אחר (כולל מנותק) יקבל 404. ברירת המחדל: yanivgolt@gmail.com
PLATFORM_ADMIN_EMAILS="yanivgolt@gmail.com"

# פרטי קשר לפניות שדרוג/מכירות (אופציונלי; ריק = שימוש בברירות המחדל בקוד).
# מוצגים בבלוק "שדרוג ופנייה עסקית" בעמוד הנחיתה ובמסך ה-paywall.
PLATFORM_CONTACT_PHONE="052-473-4788"
PLATFORM_CONTACT_EMAIL="yanivgolt@gmail.com"

# ── התראת בעל האתר על בקשת הצעת מחיר (D3: מייל תמיד + וואטסאפ מיטבי) ──
# כשבעל עסק שולח בקשת הצעת מחיר מ-/admin/upgrade, הבקשה *נשמרת תחילה* במסד
# (PlanInquiry), ורק אז נשלחת התראה לבעל האתר. אף ערוץ אינו חוסם את הבקשה
# ואף אחד אינו זורק שגיאה — כל כשל מתועד ללוג בלבד.
#
# יעד המייל של בעל האתר. ריק = נפילה ל-PLATFORM_CONTACT_EMAIL, ובהיעדרו
# לברירת המחדל בקוד (yanivgolt@gmail.com).
OWNER_NOTIFY_EMAIL="yanivgolt@gmail.com"
# יעד הוואטסאפ של בעל האתר (E.164; הקידומת "whatsapp:" נוספת אוטומטית).
# ריק = נפילה לברירת המחדל בקוד (CONTACT.PHONE_E164 = +972524734788).
OWNER_WHATSAPP_TO="+972524734788"
#
# מתאם וואטסאפ Twilio (מגודר, ניתן להחלפה). שלושת הסודות נדרשים כדי להפעיל
# שליחת וואטסאפ בפועל; אם אחד מהם ריק — הוואטסאפ *מדולג בחן* והמייל+ההתמדה
# ממשיכים כרגיל. אין להטמיע סודות בקוד — קריאה מ-env בלבד.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# מספר השולח המאושר ב-Twilio WhatsApp, למשל "+14155238886" (Sandbox) או מספר עסקי.
TWILIO_WHATSAPP_FROM=""
