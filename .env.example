# חיבור למסד הנתונים (PostgreSQL)
# עדכנו שם משתמש, סיסמה, מארח, פורט ושם מסד לפי הסביבה שלכם.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/torchick_dev?schema=public"

# אזור זמן עסקי ברירת מחדל (IANA)
BUSINESS_TIMEZONE="Asia/Jerusalem"

# מפתח לחתימת עוגיית ההתחברות של הלקוח (מחרוזת אקראית ארוכה)
SESSION_SECRET="change-me-to-a-long-random-string"

# "פלפל" להצפנת קודי OTP (מחרוזת אקראית ארוכה)
OTP_PEPPER="change-me-too"

# ספק ההודעות: console = הדפסה ללוג בלבד (ברירת מחדל לפיתוח).
# ערכים אפשריים: console | whatsapp-cloud (alias: whatsapp).
# בפרודקשן חובה להגדיר whatsapp-cloud, אחרת שליחת ה-OTP תיכשל ברעש.
# תאימות לאחור: אם MESSAGING_PROVIDER לא מוגדר, נקרא SMS_PROVIDER.
MESSAGING_PROVIDER="console"

# ---------------------------------------------------------------------------
# העדפת ערוץ תזכורות התור (24 שעות לפני). ברירת מחדל: WhatsApp אם הספק תומך
# ומוגדר, אחרת נפילה חלקה ל-SMS. הגדר "sms" כדי לכפות SMS בלבד.
# ---------------------------------------------------------------------------
REMINDER_CHANNEL="whatsapp"

# ---------------------------------------------------------------------------
# מתאם WhatsApp Cloud API של מטא (כאשר MESSAGING_PROVIDER=whatsapp-cloud).
# שולח OTP דרך תבנית authentication מאושרת ב-Meta, והודעות טקסט חופשי.
# ---------------------------------------------------------------------------
# חובה: מזהה מספר הטלפון העסקי (Graph phone number id).
WHATSAPP_PHONE_NUMBER_ID=""
# חובה: access token של WhatsApp Cloud API (סוד; בפרודקשן דרך secretRef).
WHATSAPP_ACCESS_TOKEN=""
# חובה: שם תבנית ה-OTP המאושרת (authentication) ב-Meta.
WHATSAPP_OTP_TEMPLATE=""
# אופציונלי: מזהה חשבון ה-WhatsApp Business (לתיעוד/עתיד).
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# אופציונלי: קוד שפת התבנית (ברירת מחדל he; חייב להתאים לתבנית שאושרה, למשל en_US).
WHATSAPP_OTP_TEMPLATE_LANG="he"
# אופציונלי: סוג כפתור העתקת-קוד בתבנית (ברירת מחדל url; none/ריק = ללא כפתור).
WHATSAPP_OTP_BUTTON_SUBTYPE="url"
# אופציונלי: גרסת Graph API (ברירת מחדל v21.0).
WHATSAPP_GRAPH_VERSION="v21.0"
# אופציונלי: כתובת בסיס של Graph (ברירת מחדל https://graph.facebook.com).
WHATSAPP_GRAPH_BASE_URL="https://graph.facebook.com"
# אופציונלי: קידומת מדינה ברירת מחדל לנרמול מספרים מקומיים (ברירת מחדל 972).
WHATSAPP_DEFAULT_COUNTRY_CODE="972"

# ---------------------------------------------------------------------------
# הגבלת קצב של בקשות OTP (הגנה מפני ניצול לרעה ועלויות). ערכים אופציונליים.
# ---------------------------------------------------------------------------
# קול-דאון בין שליחות חוזרות לאותו טלפון (שניות; ברירת מחדל 60).
OTP_COOLDOWN_SECONDS="60"
# תקרת בקשות ליום לכל טלפון (ברירת מחדל 8).
OTP_MAX_PER_PHONE_PER_DAY="8"
# תקרת בקשות ליום לכל כתובת IP (ברירת מחדל 30).
OTP_MAX_PER_IP_PER_DAY="30"

# כתובת בסיס ציבורית של האפליקציה (מזינה את ה-canonical וה-Open Graph).
# בפרודקשן יש להגדיר לכתובת הדומיין, למשל https://torchick.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# סוד לאימות ה-cron של התזכורות (/api/cron/reminders).
# מחרוזת אקראית ארוכה. חייב להיות מוגדר באותו ערך בשני מקומות בפרודקשן:
#   1) Repository secret בשם CRON_SECRET (ה-workflow המתוזמן שולח אותו ככותרת).
#   2) משתנה סביבה CRON_SECRET על ה-Container App (torchick-app-prod).
# אם השניים לא תואמים, ה-endpoint יחזיר 401 וההודעות לא יישלחו.
CRON_SECRET="change-me-to-a-long-random-string"
